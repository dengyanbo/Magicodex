+fn selected_style(
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> Option<MagicStyle> {
+    std::iter::from_fn(|| events.try_recv().ok()).find_map(|event| match event {
+        AppEvent::MagicStyleSelected(style) => Some(style),
+        _ => None,
+    })
