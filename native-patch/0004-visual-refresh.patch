+fn draw_idle(canvas: &mut Canvas<'_>, radius: f64) {
+    canvas.arc((0.0, 0.0), radius, (0.0, TAU), |_| Ink::Line);
+    canvas.arc((0.0, 0.0), radius - 2.5, (0.0, TAU), |_| Ink::Faint);
+    if let Some(cell) = canvas.cell_of(/*x*/ 0.0, /*y*/ 0.0) {
+        canvas.write(
